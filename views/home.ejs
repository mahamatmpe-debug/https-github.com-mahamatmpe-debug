<div class='hero'>
  <h1>Catalogue de composants</h1>
  <p>Consultez, commandez ou demandez des informations</p>
  <div class='hero-actions'>
    <a class='btn primary' href='/orders'>Passer commande</a>
    <a class='btn' href='/inquiries'>Poser une question</a>
  </div>
</div>

<div class='grid' id='product-grid'>
  <% components.forEach(function(c){ %>
    <article class='card' data-id='<%= c.id %>' data-name='<%= c.name %>' data-price='<%= c.price %>' data-file='<%= c.file %>' data-type='<%= c.type %>'>
      <div class='card-media'>
        <% if (c.type === 'image') { %>
          <img src='<%= c.file %>' alt='<%= c.name %>' loading='lazy'>
        <% } else { %>
          <video src='<%= c.file %>' controls preload='metadata'></video>
        <% } %>
      </div>
      <div class='card-body'>
        <h2 class='card-title'><%= c.name %></h2>
        <div class='card-meta'>
          <span class='price'><%= c.price %> <%= currency %></span>
        </div>
        <div class='card-actions'>
          <button class='btn small js-quickview'>Apercu</button>
          <button class='btn small primary js-add-cart'>Ajouter au panier</button>
        </div>
        <div class='card-share'>
          <a class='share-fb' target='_blank' rel='noopener' href='https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(baseUrl + c.file) %>'>Partager sur Facebook</a>
        </div>
      </div>
    </article>
  <% }) %>
</div>

<div id='quickview' class='modal' hidden>
  <div class='modal-content'>
    <button class='modal-close js-close-qv'>&times;</button>
    <div id='qv-body'></div>
  </div>
</div>
